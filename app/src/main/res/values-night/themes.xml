<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LifePluse" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
         <item name="colorPrimary">@color/status_bar</item>
        <item name="android:windowIsTranslucent">true</item>

    </style>


    <style name="CustomCardViewStyle" parent="@style/Widget.MaterialComponents.CardView">

        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay_card_custome_corners</item>

    </style>

    <style name="ShapeAppearanceOverlay_card_custome_corners" parent="">

        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomRight">50dp</item>
        <item name="cornerSizeBottomLeft">50dp</item>

    </style>
</resources>