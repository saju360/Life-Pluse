<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:gravity="center"
    android:id="@+id/inreview_layout"
    android:visibility="gone"
    android:orientation="vertical">


    <ImageView
        android:id="@+id/review_icon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="8dp"
        app:tint="@color/red"
        android:src="@drawable/in_review_icon" />

    <TextView
        android:id="@+id/time_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:fontFamily="sans-serif-black"
        android:text="Request Submited: 29/03/2024"
        android:textColor="#6A6868"
        android:textSize="16sp"
        android:textStyle="italic" />

    <TextView
        android:id="@+id/status_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/time_tv"
        android:layout_margin="10dp"
        android:fontFamily="sans-serif-black"
        android:text="Status: Your Blood Doner Request is In Review"
        android:textColor="@color/black"
        android:textSize="18sp" />


    <TextView
        android:id="@+id/reason_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:text="Admin Will Check Your Application and Soon You Will get a Notification."
        android:textColor="@color/black"
        android:textSize="17sp" />




    <com.google.android.material.button.MaterialButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Register Again"
        android:id="@+id/againRegisterBtn"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/red"
        android:textStyle="bold"
        android:visibility="gone"
        android:textColor="@color/white"/>


</LinearLayout>