<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/doner_list_border_sample"
    android:orientation="vertical"
    android:padding="5dp">


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardBackgroundColor="@color/white">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/org_name_tv_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:fontFamily="@font/aclonica"
                android:gravity="center_horizontal"
                android:text="Saju Blood Donation Org"
                android:textColor="#000"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/org_acc_datetvId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/roboto"
                android:gravity="center_horizontal"
                android:text="Joined: 07/03/2024"
                android:textColor="#D32F2F"
                android:textSize="12sp"
                android:textStyle="italic" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2.2"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/aclonica"
                        android:text="Address:"
                        android:textColor="#000"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/orgAddress_tv_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto"
                        android:text="255/B, Ahmed Nagar, Mirpur -1, Dhaka-1216."
                        android:textColor="#000"
                        android:textSize="14sp" />



                    <LinearLayout
                        android:layout_marginTop="8dp"
                        android:gravity="center_horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/weblink_btn"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_margin="8dp"
                            android:src="@drawable/icon_website"
                            />


                        <ImageView
                            android:id="@+id/fblink_btn"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/icon_fb"
                            android:layout_margin="8dp"
                            />

                        <ImageView
                            android:id="@+id/instalink_btn"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/icon_insta"
                            android:layout_margin="8dp"
                            />

                        <ImageView
                            android:id="@+id/youtlink_btn"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/icon_youtube"
                            android:layout_margin="8dp"
                            />

                    </LinearLayout>




                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight=".8"
                    android:gravity="right"
                    android:orientation="vertical">


                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/org_callAnimationId"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        app:lottie_rawRes="@raw/call_us_animation"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        android:layout_gravity="center" />




                </LinearLayout>

            </LinearLayout>


        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>





</LinearLayout>
