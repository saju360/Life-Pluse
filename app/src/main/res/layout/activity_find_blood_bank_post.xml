<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activity.Find_Blood_Bank_Post">


    <LinearLayout
        android:id="@+id/locationtopLayout"
        style="@style/CustomCardViewStyle"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="@color/blood_splashbg"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="3">

        <ImageView
            android:id="@+id/button_back"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight=".5"
            android:src="@drawable/baseline_arrow_back" />

        <LinearLayout
            android:id="@+id/locationLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_weight="2.5"
            android:gravity="right"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/org_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/location_background"
                android:elevation="20sp"
                android:gravity="center"
                android:padding="8dp"
                android:text="Add Your Blood Bank"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

        </LinearLayout>


    </LinearLayout>

    <ScrollView
        android:layout_below="@id/locationtopLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/orgnameinputlayoutId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:elevation="20dp"
                android:hint="Enter Blood Bank name here*"
                android:textColorHint="@color/black"
                app:hintTextAppearance="@style/TextAppearance.AppCompat.Large">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/orgname_Ed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/black" />


            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/orgaddressinputlayoutId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:elevation="20dp"
                android:hint="Enter Blood Bank Address here*"
                android:textColorHint="@color/black"
                app:hintTextAppearance="@style/TextAppearance.AppCompat.Large">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/orgaddress_Ed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/black" />


            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/orgphoneinputlayoutId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:elevation="20dp"
                android:hint="Enter Blood Bank Phone here*"
                android:textColorHint="@color/black"
                app:hintTextAppearance="@style/TextAppearance.AppCompat.Large">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/orgphone_Ed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/black" />


            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/orgemailinputlayoutId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:elevation="20dp"
                android:hint="Enter Blood Bank Email here*"
                android:textColorHint="@color/black"
                app:hintTextAppearance="@style/TextAppearance.AppCompat.Large">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/orgemail_Ed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/black" />


            </com.google.android.material.textfield.TextInputLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/alata"
                android:text="Social Sites:"
                android:textColor="#000"
                android:textSize="18sp"
                android:textStyle="bold" />


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/orgfbinputlayoutId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:elevation="20dp"
                android:hint="Enter Blood Bank Facebook Link* "
                android:textColorHint="@color/black"
                app:hintTextAppearance="@style/TextAppearance.AppCompat.Large">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/orgfb_Ed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/icon_fb"
                    android:drawablePadding="8dp"
                    android:inputType="text"
                    android:textColor="@color/black" />


            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/orginstainputlayoutId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:elevation="20dp"
                android:hint="Enter Blood Bank Instagram Link "
                android:textColorHint="@color/black"
                app:hintTextAppearance="@style/TextAppearance.AppCompat.Large">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/orginsta_Ed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/icon_insta"
                    android:drawablePadding="8dp"
                    android:inputType="text"
                    android:textColor="@color/black" />


            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/orgyoutputlayoutId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:elevation="20dp"
                android:hint="Enter Blood Bank Youtube Link "
                android:textColorHint="@color/black"
                app:hintTextAppearance="@style/TextAppearance.AppCompat.Large">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/orgyout_Ed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/icon_youtube"
                    android:drawablePadding="8dp"
                    android:inputType="text"
                    android:textColor="@color/black" />


            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/orgwebinputlayoutId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:elevation="20dp"
                android:hint="Enter Blood Bank Website Link "
                android:textColorHint="@color/black"
                app:hintTextAppearance="@style/TextAppearance.AppCompat.Large">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/orgweb_Ed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/icon_website"
                    android:drawablePadding="8dp"
                    android:inputType="text"
                    android:textColor="@color/black" />


            </com.google.android.material.textfield.TextInputLayout>


            <ProgressBar
                android:id="@+id/progressbarId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/colorPrimary"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                />

            <!-- Buttons -->
            <LinearLayout
                android:id="@+id/sumbitBtnLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/org_cancelButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cancelBtn" />

                <Button
                    android:id="@+id/org_AddButton"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Add"
                    android:textColor="@color/white" />
            </LinearLayout>




        </LinearLayout>

    </ScrollView>


</RelativeLayout>