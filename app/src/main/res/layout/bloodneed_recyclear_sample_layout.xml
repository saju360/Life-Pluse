<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:background="@color/white"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/card_background_color"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/bloodNeedTitleSTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:text="O+ Blood Urgent Need"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />


            <TextView
                android:id="@+id/blooddonateDateSId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto"
                android:gravity="center"
                android:text="Blood Donate Date: Today"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:layout_marginTop="5dp" />

            <!-- Post Time TextView -->
            <TextView
                android:id="@+id/postTimeTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto"
                android:gravity="center"
                android:text="Posted 2 hours ago"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="5dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="3"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.5"
                    android:orientation="vertical">


                    <TextView
                        android:id="@+id/bloodTypeId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Blood Type"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:id="@+id/bloodQtyId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Blood Needed Quantity: 2 bags "
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginTop="5dp" />


                    <TextView
                        android:id="@+id/hospitalNameId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Hospital Name: "
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginTop="5dp" />


                    <TextView
                        android:id="@+id/referenceNameId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Reference Name: "
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginTop="5dp" />


                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight=".5"
                    android:layout_gravity="center">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/callAnimationId"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        app:lottie_rawRes="@raw/call_us_animation"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        android:layout_gravity="center" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
