<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="8dp"
    >


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:cardCornerRadius="8dp"
        android:backgroundTint="@color/cardview_bg"
        android:elevation="10dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="3"
            android:padding="5dp"
            >

            <!-- profile image start-->

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                app:cardCornerRadius="5dp"
                android:elevation="5dp"
                >

                <ImageView
                    android:id="@+id/doctorImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/avatar"
                    />


            </androidx.cardview.widget.CardView>

            <!-- profile image end-->

            <!-- profile details start-->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="2"
                android:layout_margin="5dp"
                >


                <TextView
                    android:id="@+id/docSNameTextId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Prof. (Dr.)Abduz Zaher"
                    android:textSize="16sp"
                    android:fontFamily="@font/aclonica"
                    android:textColor="@color/text_color"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"

                    />

                <TextView
                    android:id="@+id/docSqualificationTextId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MBBS, FCPS (Medicine), FACC (USA), FRCP"
                    android:textSize="14sp"
                    android:textColor="@color/text_color"
                    android:layout_marginBottom="5dp"

                    />

                <TextView
                    android:id="@+id/docSptextId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Professor of Cardiology"
                    android:textSize="14sp"
                    android:textColor="@color/text_color"
                    android:layout_marginBottom="5dp"

                    />

                <TextView
                    android:id="@+id/docShospitalnameId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:text="Square Hospital Ltd"
                    android:textColor="@color/text_color"
                    android:layout_marginBottom="5dp"

                    />

                <TextView
                    android:id="@+id/docShpAddressId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:text="Mirpur-1, Dhaka-1216."
                    android:textColor="@color/text_color"
                    />

                <Button
                    android:id="@+id/bookappoinmentBtnId"
                    android:layout_margin="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Book Appointment"
                    android:backgroundTint="#03A9F4"
                    android:textColor="@color/white"
                    />



            </LinearLayout>


            <!-- profile details end-->



        </LinearLayout>







    </androidx.cardview.widget.CardView>







</LinearLayout>