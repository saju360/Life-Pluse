<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".activity.DoctorProfileview">

    <include layout="@layout/material_toolbar_layout" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:elevation="20dp"
        android:padding="5dp"
        app:cardCornerRadius="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/doctorImageId"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:elevation="20sp"
                android:src="@drawable/avatar"
                app:civ_border_color="@color/status_bar"
                app:civ_border_width="2dp" />

            <TextView
                android:id="@+id/doctorNameId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:fontFamily="@font/alata"
                android:padding="5dp"
                android:text="Doctor Name"
                android:textColor="@color/text_color"
                android:textSize="18sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/view_bg" />

            <TextView
                android:id="@+id/doctorQualificationId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:fontFamily="@font/alata"
                android:padding="5dp"
                android:text="Qualification"
                android:textColor="@color/text_color"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/view_bg" />

            <TextView
                android:id="@+id/doctorSpecialityId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:fontFamily="@font/alata"
                android:padding="5dp"
                android:text="Doctor Specialty"
                android:textColor="@color/text_color"
                android:textSize="16sp"

                />


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/view_bg" />


            <TextView
                android:id="@+id/hospitalNameId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:fontFamily="@font/alata"
                android:padding="5dp"
                android:text="Hospital Name"
                android:textColor="@color/text_color"
                android:textSize="17sp"

                />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/view_bg" />


            <TextView
                android:id="@+id/hospitalContactId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:fontFamily="@font/alata"
                android:padding="5dp"
                android:text="Hospital contact"
                android:textColor="@color/text_color"
                android:textSize="17sp"

                />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/view_bg" />


            <TextView
                android:id="@+id/visitinghourId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:fontFamily="@font/alata"
                android:padding="5dp"
                android:text="Saturday: 05:30 pm to 09:00 pm"
                android:textColor="@color/text_color"
                android:textSize="16sp"

                />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/view_bg" />



            <Button
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/button_bg"
                android:text="Book Appointmant"
                android:layout_margin="10dp"
                />



        </LinearLayout>


    </androidx.cardview.widget.CardView>


</LinearLayout>