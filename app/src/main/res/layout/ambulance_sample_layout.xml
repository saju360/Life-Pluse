<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:layout_margin="5dp"
    android:backgroundTint="@color/cardview_bg"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:layout_margin="5dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/SambulaneImgId"
                    android:layout_width="80dp"
                    android:layout_height="60dp"
                    android:layout_margin="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ambulance" />
            </LinearLayout>



            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/callAnimationId"
                android:layout_width="90dp"
                android:layout_height="90dp"
                app:lottie_rawRes="@raw/call_us_animation"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                android:layout_gravity="center" />

            <!-- add more views as needed -->


        </LinearLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_margin="5dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/SambNameId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="5dp"
                android:fontFamily="@font/roboto_medium"
                android:text="Lab Aid"
                android:textColor="@color/text_color"
                android:textSize="18sp" />



        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_margin="5dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/SambAddressId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_marginLeft="5dp"
                android:fontFamily="@font/roboto_medium"
                android:text="Lab Aid"
                android:textStyle="italic"
                android:layout_centerVertical="true"
                android:textColor="#767272"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/SambulancedelteBtn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginRight="25sp"
                android:scaleType="fitCenter"
                android:layout_alignParentRight="true"
                android:src="@drawable/delete_icon"
                app:tint="@color/red" />


        </RelativeLayout>

    </LinearLayout>


</androidx.cardview.widget.CardView>