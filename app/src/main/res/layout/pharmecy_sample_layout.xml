<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:layout_margin="5dp"
    android:backgroundTint="@color/cardview_bg"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/SpharmecyImgId"
                    android:layout_width="80dp"
                    android:layout_height="60dp"
                    android:layout_margin="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/pharmecy_icon" />


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="15dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/SphNameId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Lab Aid"
                        android:layout_marginBottom="5dp"
                        android:layout_gravity="center_horizontal"
                        android:textColor="@color/text_color"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/regNoId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/autour_one"
                        android:text="Reg. No: 123456789"
                        android:textColor="@color/black"
                        android:layout_marginBottom="5dp"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/SphAddressId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Lab Aid"
                        android:textColor="#767272"
                        android:textSize="12sp"
                        android:maxLines="2"
                        android:layout_gravity="center_horizontal"
                        android:ellipsize="end"
                        android:textStyle="italic" />

                </LinearLayout>


                .
            </LinearLayout>


            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/callAnimationId"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/call_us_animation" />


        </LinearLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <ImageView
                    android:id="@+id/weblink_btn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/icon_website"
                    />


                <ImageView
                    android:id="@+id/fblink_btn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/icon_fb"
                    android:layout_margin="8dp"
                    />

                <ImageView
                    android:id="@+id/instalink_btn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/icon_insta"
                    android:layout_margin="8dp"
                    />

                <ImageView
                    android:id="@+id/youtlink_btn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/icon_youtube"
                    android:layout_margin="8dp"
                    />



            </LinearLayout>



            <ImageView
                android:id="@+id/SambulancedelteBtn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentRight="true"
                android:layout_marginRight="25sp"
                android:scaleType="fitCenter"
                android:src="@drawable/delete_icon"
                android:layout_centerVertical="true"
                app:tint="@color/red" />


        </RelativeLayout>

    </LinearLayout>


</androidx.cardview.widget.CardView>